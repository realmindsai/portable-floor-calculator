{
  "name": "portable-floor-calculator",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node tests/static-server.mjs out",
    "test:unit": "node --experimental-strip-types --test app/lib/floor-calculator.test.ts",
    "test:integration": "node --test tests/page-source.test.mjs tests/rendered-html.test.mjs",
    "test:e2e": "node --test tests/floor-calculator.e2e.mjs",
    "test": "npm run test:unit && npm run build && npm run test:integration && npm run test:e2e",
    "lint": "eslint app tests next.config.ts --max-warnings=0"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "typescript": "5.9.3"
  },
  "type": "module"
}
